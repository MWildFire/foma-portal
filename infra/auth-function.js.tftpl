// Rendered by Terraform from infra/auth-function.js.tftpl. Do not edit in the console.
// Runtime cloudfront-js-2.0, viewer-request. Plain ES5 style on purpose.
var crypto = require('crypto');
var APEX_HOST = '${apex_domain}';
var WWW_HOST = 'www.${apex_domain}';
// SHA-256 hex digests of the two expected Authorization header values. No passwords here.
var TOKEN_HASHES = ${jsonencode(token_hashes)};

function handler(event) {
  var request = event.request;
  var headers = request.headers;

  // 1. www -> apex redirect, before any auth check.
  var host = headers.host ? headers.host.value.toLowerCase() : '';
  if (host === WWW_HOST) {
    return {
      statusCode: 301,
      statusDescription: 'Moved Permanently',
      headers: {
        location: { value: 'https://' + APEX_HOST + request.uri }
      }
    };
  }

  // 2. Basic Auth: the digest of the Authorization header must equal one of the expected digests.
  var allowed = false;
  if (headers.authorization) {
    var suppliedHash = crypto.createHash('sha256').update(headers.authorization.value).digest('hex');
    for (var i = 0; i < TOKEN_HASHES.length; i++) {
      if (suppliedHash === TOKEN_HASHES[i]) {
        allowed = true;
      }
    }
  }

  if (!allowed) {
    return {
      statusCode: 401,
      statusDescription: 'Unauthorized',
      headers: {
        'www-authenticate': { value: 'Basic realm="Foma Learning Portal", charset="UTF-8"' }
      }
    };
  }

  // 3. Authorised: pass the request on to the cache / origin.
  return request;
}
